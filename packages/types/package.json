{
  "name": "@iter/types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./xOAuth": {
      "types": "./dist/xOAuth.d.ts",
      "default": "./dist/xOAuth.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./quoteDisplay": {
      "types": "./dist/quoteDisplay.d.ts",
      "default": "./dist/quoteDisplay.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/xOAuth.ts src/session.ts src/quoteDisplay.ts --format esm --dts --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "decimal.js": "^10.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@circle-fin/bridge-kit": "^1.14.1",
    "@iter/typescript-config": "workspace:*",
    "@types/node": "^22.13.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}

    "verify": "node scripts/verify.mjs",
    "sync": "node scripts/sync-deployment.mjs"
  },
  "devDependencies": {
    "@iter/typescript-config": "workspace:*",
    "@types/node": "^22.13.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  }
}

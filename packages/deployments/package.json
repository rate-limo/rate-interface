{
  "name": "@iter/deployments",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./deployments.json": "./deployments.json"
  },
  "files": [
    "dist",
    "deployments.json",
    "scripts"
  ],
  "scripts": {
    "build": "tsup",

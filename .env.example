# The interface talks to services it does not contain.
#
# `pnpm dev` runs with none of these set — pages render with empty or fallback
# data. `pnpm build` does NOT: next.config.ts refuses a production build without
# the variables below, deliberately, because Next resolves rewrites at BUILD
# time and an unset value silently bakes `http://localhost:4100` into the output.
# That failure is invisible — every hop answers 200 and the feature is simply
# gone — so the build stops instead. Any reachable URL satisfies it.

# Per-chain operator reads: /graduate, /thesis/*, /launch-config.
# One per chain in SUPPORTED_CHAINS (see packages/deployments). The unsuffixed
# variable cannot stand in for these: it can serve one chain and nothing records
# which, so a request for the other chain would be answered from the wrong data.
ADMIN_SERVICE_URL=http://localhost:4100
ADMIN_SERVICE_URL_5042002=http://localhost:4100
ADMIN_SERVICE_URL_11155931=http://localhost:4100

# Chain-agnostic reads: logos, chain marks, profiles, the transfer-route list.
IDENTITY_SERVICE_URL=https://auth.rate.limo

# Wallet connect modal. Get one at https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Indexer gateways are compiled in from packages/deployments — see
# PonderLinks / PonderWssLinks there rather than setting them here.
